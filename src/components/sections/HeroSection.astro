---
const { hero } = Astro.props;
---

<section class="hero-card" style={`--hero-mask-image: url("${hero.image}")`}>
  <div class="hero-overhang" aria-hidden="true">
    <picture class="hero-image hero-image-overhang">
      <source media="(max-width: 767px)" srcset={hero.imageMobile} type="image/avif" />
      <source media="(max-width: 767px)" srcset={hero.imageMobileFallback} type="image/png" />
      <img src={hero.image} alt="" width="2800" height="1546" />
    </picture>
    <div class="hero-overlay hero-overlay-overhang"></div>
  </div>
  <div class="hero-surface" aria-hidden="true">
    <picture class="hero-image hero-image-base">
      <source media="(max-width: 767px)" srcset={hero.imageMobile} type="image/avif" />
      <source media="(max-width: 767px)" srcset={hero.imageMobileFallback} type="image/png" />
      <img src={hero.image} alt="" width="2800" height="1546" />
    </picture>
    <div class="hero-overlay hero-overlay-surface"></div>
    <div class="hero-shade"></div>
  </div>
  <div class="hero-copy">
    <div class="hero-copy-inner">
      <h1><span>{hero.title}</span></h1>
      <p><span>{hero.description}</span></p>
    </div>
  </div>
</section>
