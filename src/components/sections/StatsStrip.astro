---
const { stats } = Astro.props;
---

<section
  class="stats-strip"
  aria-label="Gearbox metrics"
  data-motion-group="stats-strip"
  data-motion-threshold="0.5"
  data-motion-stagger="150"
>
  {stats.map((item, index) => (
    <article
      class="stat-pill"
      data-stat-card={item.apiField || undefined}
      data-motion-item
      data-motion-index={index}
      data-motion-content="move-up-fade-in"
    >
      <div class="stat-pill-copy">
        <div class="stat-pill-value">
          <strong
            data-stat-source={item.apiSource || undefined}
            data-stat-key={item.apiField || undefined}
            data-stat-format={item.apiFormat || undefined}
            data-stat-fallback={item.value}
          >
            {item.value}
          </strong>
          {item.apiField && <span class="stat-pill-spinner" aria-hidden="true"></span>}
        </div>
        <span class="stat-pill-label">{item.label}</span>
      </div>
    </article>
  ))}
</section>
